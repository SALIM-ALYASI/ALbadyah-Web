APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=al_badyah
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# الإعداد العام (dev). لإرسال دورة مراجعة البادية الفعلية عبر Gmail SMTP،
# استبدل القيم أدناه — لا تضع أي App Password أو Secret هنا في .env.example،
# فقط في .env المحلي (غير متتبَّع بـ git).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Badyah Review Bot"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin Panel Security
ADMIN_SECRET=admin123

# Badyah Smart Engine — Ingest API token (n8n / bot only). مستقل تمامًا،
# ولّده بـ: php artisan tinker --execute="echo Str::random(64);"
BADYAH_BOT_TOKEN=

# Badyah Smart Engine — AI classification provider (Groq، مستقل تمامًا عن ALYASI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Badyah Smart Engine — بريد استلام دفعات مراجعة Gmail. لازم يكون معبّى قبل
# أي إرسال فعلي (badyah:send-review-batch --send)، وإلا يرفض الأمر التشغيل.
BADYAH_REVIEW_EMAIL=

